# Flask Secret Key
SECRET_KEY=your-secret-key-here

# Database URIs
DATABASE_1_URI=sqlite:///data/sample_db_1.db
DATABASE_2_URI=sqlite:///data/sample_db_2.db

# Langflow API URL
LANGFLOW_API_URL=http://langflow:7860

# Kakao API Key
KAKAO_API_KEY=your_kakao_api_key

# Log File Path
LOG_FILE=app.log

# Langflow API Key
LANGFLOW_API_KEY=your-langflow-api-key
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=securepassword
LANGFLOW_SECRET_KEY=your-secure-secret-key
LANGFLOW_AUTO_SAVING=true

# Flask 애플리케이션 설정
FLASK_APP=src/app/main.py
FLASK_ENV=development

# 데이터베이스 설정
DB_PATH=data/evaluation.db
DATABASE_URL=sqlite:///data/app.db
REDIS_URL=redis://redis:6379/0

# 로깅 설정
LOG_LEVEL=INFO

# 테스트 설정
TEST_DB_PATH=data/test.db
TESTING=False

# JWT 설정
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600

# 보안 설정
API_KEY=your-api-key-here
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

