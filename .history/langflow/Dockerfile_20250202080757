FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Langflow
RUN pip install --no-cache-dir langflow==0.4.0

# Create entrypoint script
RUN echo '#!/bin/bash\n\
langflow run --host 0.0.0.0 --port 7860 \
    --database-url "$LANGFLOW_DATABASE_URL" \
    --backend-meta-title "$LANGFLOW_BACKEND_META_TITLE" \
    --superuser "$LANGFLOW_SUPERUSER" \
    --superuser-password "$LANGFLOW_SUPERUSER_PASSWORD" \
    --secret-key "$LANGFLOW_SECRET_KEY"' > /entrypoint.sh && \
    chmod +x /entrypoint.sh

EXPOSE 7860

CMD ["/entrypoint.sh"] 