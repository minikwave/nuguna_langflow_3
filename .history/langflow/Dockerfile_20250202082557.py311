FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.langflow.txt .
RUN pip install --no-cache-dir -r requirements.langflow.txt

COPY scripts/run_langflow.py .

EXPOSE 7860

CMD ["python", "run_langflow.py"] 