FROM python:3.11-slim

WORKDIR /app

# 기본 도구 및 PostgreSQL 클라이언트 설치
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    postgresql-client \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 의존성 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 애플리케이션 코드 복사
COPY . .

# 시작 스크립트 생성
RUN echo '#!/bin/sh\n\
set -e\n\
\n\
# DB 연결 대기\n\
echo "Waiting for database..."\n\
until pg_isready -h db -p 5432 -U postgres; do\n\
    sleep 2\n\
done\n\
\n\
echo "Database is ready"\n\
\n\
# Flask 환경 변수 설정\n\
export FLASK_APP=app.py\n\
export FLASK_ENV=development\n\
export FLASK_DEBUG=1\n\
\n\
echo "Starting Flask application..."\n\
exec flask run --host=0.0.0.0 --port=5000\n\
' > /init.sh && chmod +x /init.sh

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

CMD ["/init.sh"] 