FROM python:3.11-slim

WORKDIR /app

# 기본 도구 및 PostgreSQL 클라이언트 설치
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    postgresql-client \
    libpq-dev \
    netcat-traditional \
    git \
    && rm -rf /var/lib/apt/lists/*

# Python 패키지 업그레이드
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# 의존성 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# gunicorn과 추가 의존성 설치
RUN pip install --no-cache-dir gunicorn uvicorn[standard]

# 애플리케이션 코드 복사
COPY . .

# 시작 스크립트 생성
RUN echo "#!/bin/bash" > /entrypoint.sh && \
    echo "set -e" >> /entrypoint.sh && \
    echo "" >> /entrypoint.sh && \
    echo "echo 'Waiting for database...'" >> /entrypoint.sh && \
    echo "while ! nc -z db 5432; do" >> /entrypoint.sh && \
    echo "    echo 'Database is not ready - waiting'" >> /entrypoint.sh && \
    echo "    sleep 2" >> /entrypoint.sh && \
    echo "done" >> /entrypoint.sh && \
    echo "echo 'Database is ready'" >> /entrypoint.sh && \
    echo "" >> /entrypoint.sh && \
    echo "# Initialize extensions if needed" >> /entrypoint.sh && \
    echo "python -c 'from app.core.init_db import init_extensions; init_extensions()'" >> /entrypoint.sh && \
    echo "" >> /entrypoint.sh && \
    echo "echo 'Starting FastAPI application...'" >> /entrypoint.sh && \
    echo "exec gunicorn app.main:app --bind 0.0.0.0:5000 --workers 4 --worker-class uvicorn.workers.UvicornWorker --timeout 120 --access-logfile - --error-logfile - --log-level info --reload" >> /entrypoint.sh

# 실행 권한 추가
RUN chmod +x /entrypoint.sh

# 상태 확인
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

CMD ["/entrypoint.sh"] 