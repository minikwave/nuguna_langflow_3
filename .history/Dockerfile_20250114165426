# Use Python 3.9 as the base image
FROM python:3.9-slim

# Set the working directory in the container
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    supervisor \
    && apt-get clean

# Copy the requirements file and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Install specific dependencies separately to avoid backtracking issues
RUN pip install --no-cache-dir --no-deps google-cloud-bigquery==3.11.4 packaging==23.1
RUN pip install --no-cache-dir --no-deps google-api-core==2.11.0 google-auth==2.16.1 googleapis-common-protos==1.58.0
RUN pip install --no-cache-dir --no-deps langflow==0.1.2

# # Install dependencies and langflow separately
# RUN pip install --no-cache-dir fastapi uvicorn streamlit
# RUN pip install google-api-core google-auth googleapis-common-protos
# # RUN pip install --no-cache-dir --no-deps google-cloud-bigquery==3.11.4 
# # RUN pip install --no-cache-dir langflow
# RUN pip install --no-deps google-cloud-core packaging
# RUN pip install langflow


# Copy the application code into the container
COPY . .

# Copy supervisord configuration
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Expose necessary ports. 8000 is for FastAPI, 9090 is for Prometheus, 7860 is for Langflow, 8501 is for Streamlit
# Expose necessary ports
EXPOSE 8000  
EXPOSE 7860  
EXPOSE 8501  
EXPOSE 9090
# EXPOSE 8501

# Command to run supervisord
CMD ["supervisord", "-n", "bash", "-c", "
    uvicorn app.main:app --host 0.0.0.0 --port 8000 &
    streamlit run frontend/app.py --server.port 8501 --server.enableCORS false &
    langflow run --host 0.0.0.0 --port 7860
"


